# Rendered at container start by the nginx image (envsubst on ${...} variables).
# API_UPSTREAM: backend base URL, e.g. http://backend:8080 (docker compose)
#               or https://enterprise-copilot-api.onrender.com (Render).
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;

    client_max_body_size 25m;  # document uploads

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # API: same origin for the browser, so no CORS is needed.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        # The upstream's own host name: required when the backend sits behind a router
        # that dispatches on Host (Render), harmless with docker compose.
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Server-Sent Events: forward each agent step as soon as it is produced.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    # Hashed build assets never change: cache them for a year.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Single-page app: unknown paths (/hr/c/...) load index.html, which is never cached.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
