# Copy to .env to override. Never put secrets here: anything prefixed VITE_ ends up in the browser.

# Where the Vite dev server forwards /api requests (dev only, not bundled).
API_PROXY_TARGET=http://127.0.0.1:8080

# Backend origin baked into the build when the frontend is hosted on its own (Render Static Site).
# Leave empty locally and with docker compose: the API is then served on the same origin.
VITE_API_BASE_URL=
