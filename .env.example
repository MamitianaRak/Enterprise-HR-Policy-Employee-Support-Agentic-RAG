# --- LLM & embeddings (Google Gemini) ---
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2-preview
# Must match the dimension of the existing Pinecone index
EMBEDDING_DIMENSION=768

# --- Vector store (Pinecone) ---
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=enterprise-copilot
HR_NAMESPACE=company-hr-kb
CLOUDOPS_NAMESPACE=cloudops-runbooks

# --- Web fallback (Tavily) ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- App ---
ADMIN_API_KEY=change-me-in-production
APP_ENV=development
# Origins allowed to call the API from a browser when the frontend is hosted separately
# (comma-separated, e.g. https://enterprise-copilot.onrender.com). Leave empty locally.
CORS_ORIGINS=
TOP_K=4
MAX_RETRIES=1
MAX_SUPPORT_RETRIES=1
# CloudOps: internal query rewrites before falling back to the web, then web query rewrites
MAX_RETRIEVAL_REWRITES=1
MAX_WEB_REWRITES=1
# Previous turns used to understand follow-up questions
MEMORY_TURNS=4
# Gemini call limits (seconds / retries) and max evidence size sent to the model
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
MAX_CONTEXT_CHARS=12000
